# Revnote — local development environment template.
#
# Copy to `.env` at the repository root (never commit `.env`):
#     PowerShell:  Copy-Item .env.example .env
#     bash:        cp .env.example .env
#
# EVERY VALUE BELOW IS A THROWAWAY DEVELOPMENT DEFAULT. They are published in
# this tracked file, so they are effectively public: never reuse them outside a
# local machine. Replace every password/secret before any shared, staging or
# production deployment, and keep the real values out of git.
#
# Ownership of this file:
#   * docker-compose.yml reads it for the official PostgreSQL + RustFS services.
#   * The API / Alembic read it only when passed explicitly:
#         uv run --package revnote-api --env-file .env alembic -c apps/api/alembic.ini upgrade head
#         uv run --package revnote-api --env-file .env uvicorn revnote_api.main:create_app --factory
#     (`apps/api` also has its own optional apps/api/.env.example with defaults.)
#   * Vite reads it for the dev server (it auto-loads the repo-root .env).
#
# Only variables prefixed with VITE_ are exposed to browser code. Never add that
# prefix to a credential.

# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #
# Runtime environment: local | test | production.
# The API accepts the legacy alias ENVIRONMENT too, but APP_ENV wins.
APP_ENV=local

# --------------------------------------------------------------------------- #
# PostgreSQL
# --------------------------------------------------------------------------- #
# Consumed directly by the official postgres image. These three values are what
# the cluster is *created* with on first start; changing them later does not
# alter an existing volume. They also match `revnote_api.config.DEFAULT_DATABASE_URL`
# (`revnote:revnote@127.0.0.1:5432/revnote`), so the API reaches the cluster both
# with and without `--env-file .env`.
POSTGRES_USER=revnote
POSTGRES_PASSWORD=revnote
POSTGRES_DB=revnote

# Consumed by the API and by Alembic.
#
# Contract: PostgreSQL through the ASYNC driver only. The scheme must be exactly
# `postgresql+asyncpg` — a bare `postgresql://` (psycopg) or any sqlite/mysql URL
# is rejected at startup on purpose.
#
# The values below match `revnote_api.config.DEFAULT_DATABASE_URL` on purpose.
# That gives two working paths:
#   (a) with `--env-file .env` (what the README documents) this DSN is used;
#   (b) with no .env at all, the app falls back to the same credentials, so it
#       still reaches the cluster that compose created.
# If you change POSTGRES_PASSWORD above, change it here too, otherwise any
# database command run without `--env-file` fails with "password authentication
# failed". Percent-encode special characters (`@` -> `%40`, `:` -> `%3A`,
# `/` -> `%2F`, `#` -> `%23`).
#
# Host/port are the *host-side* values from docker-compose.yml
# (`127.0.0.1:${POSTGRES_PORT}`), because the API runs on the host, not in a
# container.
DATABASE_URL=postgresql+asyncpg://revnote:revnote@127.0.0.1:5432/revnote

# Host port for PostgreSQL. Change it if 5432 is already taken, then update
# DATABASE_URL to match.
POSTGRES_PORT=5432

# Optional. Gates the real-PostgreSQL integration tests.#   * unset  -> those tests are SKIPPED (a developer without a database is fine);
#   * set    -> they MUST connect, otherwise the run fails.
# Use a separate, disposable database for tests and create it first:
#   docker compose exec postgres psql -U revnote -d revnote -c 'CREATE DATABASE revnote_test'
# A skipped integration test is not a passed database check. The integration
# tests run a real `upgrade head` / `downgrade base`, so this database must be
# disposable and never the development one.
#TEST_DATABASE_URL=postgresql+asyncpg://revnote:revnote@127.0.0.1:5432/revnote_test
# Phase 2 migration roundtrips use a SECOND disposable database. It must not
# identify the business test database above. Never use a development database.
#TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://revnote:revnote@127.0.0.1:5432/revnote_migrations_test
# Set to 1 for acceptance: a missing test URL is a failure, not a skip.
#REQUIRE_POSTGRES_TESTS=1

# --------------------------------------------------------------------------- #
# API cross-cutting behaviour (Phase 3 defaults = locked protocol values)
# --------------------------------------------------------------------------- #
# Every key below has a working default; they are listed so an operator can see
# the contract numbers without reading the source. Only change them deliberately:
# several are protocol budgets that the API's tests assert.

# Kernel write transactions: SET LOCAL timeouts in milliseconds. The lock budget
# must not exceed the statement budget. 57014/55P03 during a confirmed failure
# become `write_busy` (retryable); a lost COMMIT acknowledgement stays `unknown`.
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Auth. Registration is closed by default (no self-service signup). Passwords are
# 8-256 characters, additionally capped at 1024 UTF-8 bytes, never trimmed.
AUTH_REGISTRATION_OPEN=false
AUTH_PASSWORD_MIN_CHARS=8
AUTH_PASSWORD_MAX_CHARS=256
# Opaque access token 600s; absolute session lifetime 30 days, refresh never
# extends it. No signing secret exists: only SHA-256 token hashes are stored.
AUTH_ACCESS_TTL_S=600
AUTH_SESSION_TTL_S=2592000
# Argon2id (memory in KiB); recorded in the hash, so a change stays migratable.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Sync. push: 1-50 ops, raw JSON <=2 MiB, HTTP-layer body_md <=256 KiB, 30s batch
# budget checked between ops only. pull: default 100 / max 500 / ~4 MiB response.
# snapshot: one REPEATABLE READ view, no pagination, 10k objects / 16 MiB.
SYNC_PUSH_MAX_OPS=50
SYNC_PUSH_MAX_BYTES=2097152
SYNC_NOTE_MAX_BYTES=262144
SYNC_PUSH_BUDGET_MS=30000
SYNC_PULL_DEFAULT_LIMIT=100
SYNC_PULL_MAX_LIMIT=500
SYNC_PULL_MAX_BYTES=4194304
SYNC_SNAPSHOT_MAX_OBJECTS=10000
SYNC_SNAPSHOT_MAX_BYTES=16777216

# CORS: explicit origins only; empty means no CORS headers at all (the default).
# Credentials are never allowed - tokens travel in the Authorization header.
CORS_ALLOW_ORIGINS=[]
# Reserved switch; this phase ships no rate limiter.
RATE_LIMIT_ENABLED=false

# --------------------------------------------------------------------------- #
# Attachments (Phase 5) - served through the API, never presigned
# --------------------------------------------------------------------------- #
# Master switch. Closed by default: an unconfigured deployment must not look
# like it supports attachments. `GET /api/v1/capabilities` reports the effective
# value, so a client hides the entry point instead of failing on first upload.
ATTACHMENTS_ENABLED=false
# Hard ceiling for one attachment, in bytes (25 MiB). Enforced as the HTTP body
# budget for the upload path AND by the storage write, which aborts the moment
# the running total passes it.
ATTACHMENT_MAX_BYTES=26214400
# How long an incomplete (`pending`) upload may live before the GC script may
# remove it. `ready` attachments are never collected automatically.
ATTACHMENT_PENDING_GRACE_S=86400
# MIME allowlist, comma-separated. Deliberately narrow. `image/svg+xml` is
# REJECTED (at startup as well as per request): an SVG is a document that can
# carry script and it would be served from our own origin.
ATTACHMENT_ACCEPTED_MIME=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain

# Object-storage connection read by `revnote_api.storage.settings`. These are
# separate from the `S3_*` keys above on purpose: those configure the compose
# services, these configure the API process. The API never presigns URLs, so it
# only needs an address it itself can reach (no `S3_PUBLIC_ENDPOINT` here).
# In development this points at the compose RustFS service.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=revnote-attachments
# Use the RustFS root credentials above for local development only. Any shared
# deployment must use a dedicated user scoped to this bucket.
S3_ACCESS_KEY=revnote_local_only
S3_SECRET_KEY=change_me_local_only
# TLS to the object store. false for the local compose service.
S3_SECURE=false
S3_TIMEOUT_S=10

# Real-object-storage acceptance tests. Same contract as REQUIRE_POSTGRES_TESTS:
# unset -> the group may be skipped for a developer without storage; set to 1 ->
# it MUST connect or the run fails. A skipped storage test is not a pass.
#REQUIRE_OBJECT_STORAGE_TESTS=1

# --------------------------------------------------------------------------- #
# RustFS (S3-compatible object storage for attachments)
# --------------------------------------------------------------------------- #
# Root credentials for the RustFS server. The development defaults match the
# public RustFS documentation; they are NOT secrets, so replace them.
# Note: RustFS rejects a root password shorter than 8 characters.
RUSTFS_ACCESS_KEY=revnote_local_only
RUSTFS_SECRET_KEY=change_me_local_only

# Private bucket created idempotently by the one-shot `object store-init` service.
# Bucket names are lowercase, 3-63 chars: [a-z0-9.-], no leading/trailing dots.
S3_BUCKET=revnote-attachments

# Host port for the RustFS S3 API. Only the host-side port is remappable: the
# containers talk to each other over the fixed internal address `object store:9000`,
# which is what the wait/init services target. The console uses 9001 internally.
S3_PORT=9000
S3_CONSOLE_PORT=9001

# `S3_ENDPOINT` — address the API process uses to reach RustFS. The API runs
# on the host in development, so this is the host-side loopback endpoint.
S3_ENDPOINT=http://127.0.0.1:9000

# `S3_PUBLIC_ENDPOINT` — address *browser/clients* use for presigned URLs.
# In development it equals S3_ENDPOINT because both live on the same machine.
# They must diverge as soon as the API runs in a container or behind a proxy:
# presigned URLs are signed for the host that the *client* dials, so reusing the
# container-internal name (e.g. http://object store:9000) produces unreachable or
# signature-mismatched URLs.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# The mc sidecars place credentials in MC_HOST_ URLs. If credentials contain
# URL-special characters, encode those values in the mc configuration before use.

# --------------------------------------------------------------------------- #
# Web (Vite dev server)
# --------------------------------------------------------------------------- #
# Target the Vite dev proxy forwards `/api/*` to. Read only by the dev server,
# never bundled into client code, and the `/api` prefix is stripped before
# forwarding (so `/api/health` -> `${API_PROXY_TARGET}/health`).
API_PROXY_TARGET=http://127.0.0.1:8000

# Base path the browser uses to reach the API. Defaults to `/api`, which the dev
# proxy handles. This is the only VITE_-prefixed variable here: it is public by
# design and must never hold a credential.
VITE_API_BASE_PATH=/api
