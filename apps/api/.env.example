# API 本地开发配置示例（可选，全部键都有可用的默认值）。
#
# 用法：复制为 `apps/api/.env`（pydantic-settings 自动读取），
# 或在 shell 中显式导出；也可由根目录显式传入 `uv run --env-file .env ...`。
# 即使没有任何 .env，API 也能以默认值启动。
#
# 注意：仓库根的 `.env` 由 compose 与根 README 管理，本服务不会隐式读取它，
# 以避免出现第二份会漂移的配置真相；需要时用 --env-file 显式传入。

# 运行环境：local | test | production（旧名 ENVIRONMENT 仍兼容，APP_ENV 优先）
APP_ENV=local

# 仅 PostgreSQL，且必须使用异步驱动（sqlite/mysql/psycopg 会被拒绝）。
DATABASE_URL=postgresql+asyncpg://revnote:revnote@127.0.0.1:5432/revnote

# SQLAlchemy 引擎参数
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# 内核写事务的 SET LOCAL 超时（毫秒）。lock 必须小于等于 statement。
# 57014 / 55P03 在确认失败时映射为 write_busy（可重试）。
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# --------------------------------------------------------------------------- #
# Phase 3 认证（默认值即锁定决策，一般无需修改）
# --------------------------------------------------------------------------- #
# 注册默认关闭；开启后注册只建 user + 默认 workspace + owner，不自动登录。
AUTH_REGISTRATION_OPEN=false
# 密码 8–256 字符（UTF-8 ≤1024 字节）；不 trim、不截断。
AUTH_PASSWORD_MIN_CHARS=8
AUTH_PASSWORD_MAX_CHARS=256
# opaque access token 600s；会话绝对寿命 30 天（refresh 不续期）。
AUTH_ACCESS_TTL_S=600
AUTH_SESSION_TTL_S=2592000
# Argon2id 参数（写入 hash，可经 check_needs_rehash 迁移）。
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --------------------------------------------------------------------------- #
# Phase 3 同步（默认值即锁定决策）
# --------------------------------------------------------------------------- #
# push：1–50 op，原始 JSON ≤2 MiB，HTTP 层 body_md ≤256 KiB，批次预算 30s。
SYNC_PUSH_MAX_OPS=50
SYNC_PUSH_MAX_BYTES=2097152
SYNC_NOTE_MAX_BYTES=262144
SYNC_PUSH_BUDGET_MS=30000
# pull：默认 100、上限 500、响应预算约 4 MiB。
SYNC_PULL_DEFAULT_LIMIT=100
SYNC_PULL_MAX_LIMIT=500
SYNC_PULL_MAX_BYTES=4194304
# snapshot：单 RR 快照，不分页，超限整次 409。
SYNC_SNAPSHOT_MAX_OBJECTS=10000
SYNC_SNAPSHOT_MAX_BYTES=16777216

# --------------------------------------------------------------------------- #
# HTTP 横切
# --------------------------------------------------------------------------- #
# 显式来源白名单；空表示完全不下发 CORS 头。绝不允许 credentials。
CORS_ALLOW_ORIGINS=[]
# 占位开关：本阶段没有任何限流实现。
RATE_LIMIT_ENABLED=false

# `uv run revnote-api` 开发服务器
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false

# 仅独立 PostgreSQL 集成测试读取；未设置时相关测试明确跳过。
# 注意：这是真实库，建议使用独立的测试数据库名。
# TEST_DATABASE_URL=postgresql+asyncpg://revnote:revnote@127.0.0.1:5432/revnote_test
